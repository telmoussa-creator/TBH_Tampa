# Anthropic (Claude) — required for AVM, concierge, photo analysis, lead scoring
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — leads, offers, photos, sessions
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# Optional: property data providers
RENTCAST_API_KEY=
ATTOMDATA_API_KEY=
GOOGLE_MAPS_API_KEY=

# Twilio (for SMS follow-up). Optional for v1.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Branding
NEXT_PUBLIC_SITE_URL=https://www.tarekbuyshouses.com
NEXT_PUBLIC_BRAND_NAME="Tarek Buys Houses"
NEXT_PUBLIC_PHONE="(813) 555-0100"
