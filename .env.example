# Anthropic (Claude) — required for AVM, concierge, photo analysis, lead scoring
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — leads, offers, photos, sessions
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# Property enrichment (RentCast — pre-fills beds/baths/sqft/year_built from address)
RENTCAST_API_KEY=

# Google Maps Places (address autocomplete on the hero)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Twilio (outbound SMS + ops notifications for hot leads)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Phone that gets notified when a hot lead comes in (Tarek's cell)
OPS_NOTIFY_NUMBER=

# Dashboard auth — comma-separated emails that may access /dashboard
DASHBOARD_ADMIN_EMAILS=tarek@tarekbuyshouses.com

# Branding
NEXT_PUBLIC_SITE_URL=https://www.tarekbuyshouses.com
